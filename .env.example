# FinSocNet v2 configuration (specs/00-conventions.md §6). No credentials: logins go through the session bridge.

# Database
KNOWLEDGE_DB_PATH=data/knowledge.db
FINSOCNET_LOG_LEVEL=INFO
# FINSOCNET_RUN_ID=            # alternative to --run on write commands

# Local Whisper transcription (the only model scripts run; ASR, not reasoning)
WHISPER_MODEL=openai/whisper-large-v3-turbo
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# Agent browser (Phase 3)
CDP_URL=http://127.0.0.1:9222
BROWSER_PROFILE_DIR=data/browser-profile
# CHROME_BIN=                  # auto-detect: google-chrome, chromium, brave-browser
XVFB_DISPLAY=:99
# FINSOCNET_PROXY=             # e.g. socks5://127.0.0.1:1080 (reverse SSH tunnel to the home IP)
# AGE_IDENTITY_FILE=~/.config/finsocnet/age_identity.txt   # remote host private key, outside the repo

# Optional keys that only raise public rate limits (not logins)
# SEC_USER_AGENT="FinSocNet you@example.com"
# STACKEXCHANGE_KEY=
# GITHUB_TOKEN=
# OPENALEX_MAILTO=
