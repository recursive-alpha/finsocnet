{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "person.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "canonical_name"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "canonical_name": {
      "type": "string",
      "minLength": 1
    },
    "moniker": {
      "type": [
        "string",
        "null"
      ]
    },
    "bio": {
      "type": [
        "string",
        "null"
      ]
    },
    "avatar_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "trading_style": {
      "type": [
        "string",
        "null"
      ]
    },
    "primary_markets": {
      "type": [
        "string",
        "null"
      ]
    },
    "verified_records": {
      "type": [
        "string",
        "null"
      ]
    },
    "visibility": {
      "enum": [
        "public",
        "private_source"
      ]
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alias"
        ],
        "properties": {
          "alias": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          }
        }
      }
    },
    "profession": {
      "enum": [
        "trader",
        "portfolio_manager",
        "investor",
        "executive",
        "founder",
        "economist",
        "academic",
        "researcher",
        "analyst",
        "strategist",
        "author",
        "journalist",
        "educator",
        "regulator",
        "central_banker",
        "other",
        null
      ]
    },
    "affiliation": {
      "type": [
        "string",
        "null"
      ]
    },
    "domains": {
      "type": [
        "string",
        "null"
      ]
    },
    "homepage": {
      "type": [
        "string",
        "null"
      ]
    },
    "relevance": {
      "type": [
        "string",
        "null"
      ]
    },
    "external_ids": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
